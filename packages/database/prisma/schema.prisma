generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum RoleLevel {
  NONE
  VIEW
  MANAGE
  APPROVE
}

enum TermStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
}

enum RecordStatus {
  DRAFT
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  VOIDED
  ARCHIVED
}

enum PaymentMethod {
  MPESA
  BANK
  CASH
  CHEQUE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
}

model School {
  id                 String         @id @default(uuid()) @db.Uuid
  name               String
  registrationNumber String         @unique @map("registration_number")
  currency           String         @default("KES")
  timezone           String         @default("Africa/Nairobi")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  users              User[]
  roles              Role[]
  academicYears      AcademicYear[]
  classes            Class[]
  guardians          Guardian[]
  students           Student[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  payments           Payment[]
  expenses           Expense[]
  budgets            Budget[]
  auditEvents        AuditEvent[]
  settings           SchoolSetting?

  @@map("schools")
}

model SchoolSetting {
  id                   String  @id @default(uuid()) @db.Uuid
  schoolId             String  @unique @map("school_id") @db.Uuid
  invoicePrefix        String  @default("INV") @map("invoice_prefix")
  receiptPrefix        String  @default("RCT") @map("receipt_prefix")
  expenseApprovalLimit Decimal @default(10000) @map("expense_approval_limit") @db.Decimal(14, 2)
  settings             Json    @default("{}")
  school               School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  schoolId            String               @map("school_id") @db.Uuid
  email               String
  passwordHash        String               @map("password_hash")
  passwordChangedAt   DateTime             @default(now()) @map("password_changed_at")
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?            @map("locked_until")
  firstName           String               @map("first_name")
  lastName            String               @map("last_name")
  phone               String?
  status              UserStatus           @default(INVITED)
  lastLoginAt         DateTime?            @map("last_login_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles               UserRole[]
  auditEvents         AuditEvent[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]

  @@unique([schoolId, email])
  @@index([schoolId, status])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([schoolId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  level        RoleLevel
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AcademicYear {
  id       String   @id @default(uuid()) @db.Uuid
  schoolId String   @map("school_id") @db.Uuid
  name     String
  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms    Term[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

model Term {
  id             String         @id @default(uuid()) @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  name           String
  startsOn       DateTime       @map("starts_on") @db.Date
  endsOn         DateTime       @map("ends_on") @db.Date
  status         TermStatus     @default(PLANNED)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrolments     Enrolment[]
  feeStructures  FeeStructure[]
  invoices       Invoice[]
  expenses       Expense[]
  budgets        Budget[]

  @@unique([academicYearId, name])
  @@map("terms")
}

model Class {
  id            String         @id @default(uuid()) @db.Uuid
  schoolId      String         @map("school_id") @db.Uuid
  name          String
  grade         String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrolments    Enrolment[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@map("classes")
}

model Student {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @map("school_id") @db.Uuid
  admissionNumber    String              @map("admission_number")
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  status             StudentStatus       @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardians          StudentGuardian[]
  enrolments         Enrolment[]
  invoices           Invoice[]
  paymentAllocations PaymentAllocation[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, lastName, firstName])
  @@map("students")
}

model Guardian {
  id        String            @id @default(uuid()) @db.Uuid
  schoolId  String            @map("school_id") @db.Uuid
  firstName String            @map("first_name")
  lastName  String            @map("last_name")
  phone     String
  email     String?
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]

  @@index([schoolId, phone])
  @@map("guardians")
}

model StudentGuardian {
  studentId    String   @map("student_id") @db.Uuid
  guardianId   String   @map("guardian_id") @db.Uuid
  relationship String
  isPrimary    Boolean  @default(false) @map("is_primary")
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model Enrolment {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @map("student_id") @db.Uuid
  classId   String  @map("class_id") @db.Uuid
  termId    String  @map("term_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class   @relation(fields: [classId], references: [id])
  term      Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
  @@index([classId, termId])
  @@map("enrolments")
}

model FeeStructure {
  id        String             @id @default(uuid()) @db.Uuid
  schoolId  String             @map("school_id") @db.Uuid
  termId    String             @map("term_id") @db.Uuid
  classId   String?            @map("class_id") @db.Uuid
  name      String
  status    RecordStatus       @default(DRAFT)
  createdAt DateTime           @default(now()) @map("created_at")
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term      Term               @relation(fields: [termId], references: [id])
  class     Class?             @relation(fields: [classId], references: [id])
  items     FeeStructureItem[]
  batches   InvoiceBatch[]

  @@index([schoolId, termId, status])
  @@map("fee_structures")
}

model FeeStructureItem {
  id             String       @id @default(uuid()) @db.Uuid
  feeStructureId String       @map("fee_structure_id") @db.Uuid
  name           String
  amount         Decimal      @db.Decimal(14, 2)
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@map("fee_structure_items")
}

model InvoiceBatch {
  id             String       @id @default(uuid()) @db.Uuid
  feeStructureId String       @map("fee_structure_id") @db.Uuid
  idempotencyKey String       @unique @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at")
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  invoices       Invoice[]

  @@map("invoice_batches")
}

model Invoice {
  id            String              @id @default(uuid()) @db.Uuid
  schoolId      String              @map("school_id") @db.Uuid
  studentId     String              @map("student_id") @db.Uuid
  termId        String              @map("term_id") @db.Uuid
  batchId       String?             @map("batch_id") @db.Uuid
  invoiceNumber String              @map("invoice_number")
  status        RecordStatus        @default(ACTIVE)
  issuedAt      DateTime            @default(now()) @map("issued_at")
  dueAt         DateTime?           @map("due_at")
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student             @relation(fields: [studentId], references: [id])
  term          Term                @relation(fields: [termId], references: [id])
  batch         InvoiceBatch?       @relation(fields: [batchId], references: [id])
  items         InvoiceItem[]
  allocations   PaymentAllocation[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  amount      Decimal @db.Decimal(14, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id                String              @id @default(uuid()) @db.Uuid
  schoolId          String              @map("school_id") @db.Uuid
  receiptNumber     String              @map("receipt_number")
  method            PaymentMethod
  reference         String
  amount            Decimal             @db.Decimal(14, 2)
  status            TransactionStatus   @default(COMPLETED)
  receivedAt        DateTime            @default(now()) @map("received_at")
  reversedPaymentId String?             @unique @map("reversed_payment_id") @db.Uuid
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allocations       PaymentAllocation[]
  reversedPayment   Payment?            @relation("PaymentReversal", fields: [reversedPaymentId], references: [id])
  reversal          Payment?            @relation("PaymentReversal")

  @@unique([schoolId, reference])
  @@unique([schoolId, receiptNumber])
  @@index([schoolId, receivedAt])
  @@map("payments")
}

model PaymentAllocation {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  studentId String  @map("student_id") @db.Uuid
  amount    Decimal @db.Decimal(14, 2)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([paymentId, invoiceId])
  @@map("payment_allocations")
}

model Expense {
  id            String            @id @default(uuid()) @db.Uuid
  schoolId      String            @map("school_id") @db.Uuid
  termId        String            @map("term_id") @db.Uuid
  expenseNumber String            @map("expense_number")
  category      String
  vendor        String
  description   String
  amount        Decimal           @db.Decimal(14, 2)
  status        RecordStatus      @default(PENDING)
  incurredAt    DateTime          @map("incurred_at") @db.Date
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term          Term              @relation(fields: [termId], references: [id])
  approvals     ExpenseApproval[]

  @@unique([schoolId, expenseNumber])
  @@index([schoolId, termId, status])
  @@map("expenses")
}

model ExpenseApproval {
  id        String       @id @default(uuid()) @db.Uuid
  expenseId String       @map("expense_id") @db.Uuid
  decision  RecordStatus
  note      String?
  decidedAt DateTime     @default(now()) @map("decided_at")
  expense   Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@map("expense_approvals")
}

model Budget {
  id       String       @id @default(uuid()) @db.Uuid
  schoolId String       @map("school_id") @db.Uuid
  termId   String       @map("term_id") @db.Uuid
  name     String
  status   RecordStatus @default(DRAFT)
  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term     Term         @relation(fields: [termId], references: [id])
  items    BudgetItem[]

  @@unique([schoolId, termId, name])
  @@map("budgets")
}

model BudgetItem {
  id        String  @id @default(uuid()) @db.Uuid
  budgetId  String  @map("budget_id") @db.Uuid
  category  String
  allocated Decimal @db.Decimal(14, 2)
  budget    Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category])
  @@map("budget_items")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  module     String
  recordType String   @map("record_type")
  recordId   String   @map("record_id")
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, module, recordId])
  @@map("audit_events")
}
